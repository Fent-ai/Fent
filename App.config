<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Run on .NET 4.8 (needed later for secure connections to Claude), and allow
       ECU Manager's older .NET 2.0-era components (Managed DirectX) to load in it. -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
